{
  "manifest_version": 1,
  "type": "ai",
  "name": "Ollama AI Provider",
  "description": {
    "en": "Run the Gladys assistant on a local Ollama model.",
    "fr": "Faites tourner l'assistant Gladys sur un modèle Ollama local."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/john/gladys-ollama-ai:1.0.0",
  "gladys_version": ">=5.3.0",
  "categories": ["assistants"],
  "keywords": ["Ollama", "LLM", "OpenAI compatible"],
  "cover_image": "https://raw.githubusercontent.com/john/gladys-ollama-ai/main/cover.jpg",
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": { "en": "Before you start", "fr": "Avant de commencer" },
      "description": {
        "en": "Run Ollama on the host with OLLAMA_CONTEXT_LENGTH=16384 so the system prompt and the tool schemas fit. Gladys is reached at {{gladys_host}}.",
        "fr": "Lancez Ollama sur l'hôte avec OLLAMA_CONTEXT_LENGTH=16384 pour que le prompt système et les schémas d'outils tiennent. Gladys est joignable sur {{gladys_host}}."
      },
      "links": [{ "url": "https://ollama.com/", "label": { "en": "Ollama", "fr": "Ollama" } }]
    },
    {
      "key": "endpoint_url",
      "type": "string",
      "label": { "en": "OpenAI-compatible endpoint", "fr": "Endpoint compatible OpenAI" },
      "placeholder": { "en": "http://172.30.0.1:11434/v1" },
      "default": "http://172.30.0.1:11434/v1",
      "required": true
    },
    {
      "key": "api_key",
      "type": "secret",
      "label": { "en": "API key (if the endpoint needs one)", "fr": "Clé d'API (si l'endpoint en demande une)" }
    },
    {
      "key": "model",
      "type": "string",
      "label": { "en": "Model", "fr": "Modèle" },
      "default": "qwen2.5:7b",
      "required": true
    },
    {
      "key": "temperature",
      "type": "number",
      "label": { "en": "Temperature", "fr": "Température" },
      "default": 0.2,
      "min": 0,
      "max": 2
    }
  ],
  "actions": [
    {
      "key": "test_completion",
      "label": { "en": "Test the model", "fr": "Tester le modèle" },
      "description": { "en": "Sends a short prompt and reports the answer time." },
      "timeout_seconds": 60
    }
  ]
}
